# Copy to backend/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here
CLAUDE_MODEL=claude-sonnet-5-5
# claude = real Claude API, mock = deterministic offline replies (good for a first demo)
AI_PROVIDER=claude
# mock = local stand-in dashboard, organizer = real integration (not implemented until docs/access exist)
DASHBOARD_MODE=mock
DATABASE_PATH=data/app.db
MOCK_DASHBOARD_DB_PATH=data/mock_dashboard.db
CORS_ORIGINS=http://localhost:5173
